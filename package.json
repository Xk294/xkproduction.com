{
  "name": "xkproduction",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name xkproduction",
    "optimize-images": "bash scripts/optimize-images.sh",
    "db.init.local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 execute xkproduction-db --local --file=schema.sql",
    "db.push": "wrangler d1 execute xkproduction-db --remote --file=schema.sql"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "nuxt": "^4.4.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "wavesurfer.js": "^7.12.7"
  },
  "devDependencies": {
    "@nuxtjs/robots": "^6.0.8",
    "@nuxtjs/sitemap": "^8.0.15",
    "nuxt-schema-org": "^3.3.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.1"
  }
}
